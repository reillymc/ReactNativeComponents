{
    "expo": {
        "name": "React Native Components",
        "slug": "react-native-components-example",
        "scheme": "rnc",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "automatic",
        "assetBundlePatterns": ["**/*"],
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#FFFFFF"
            }
        },
        "web": {
            "bundler": "metro",
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-font",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#ffffff",
                    "image": "./assets/splash.png",
                    "dark": {
                        "image": "./assets/splash.png",
                        "backgroundColor": "#000000"
                    },
                    "imageWidth": 200
                }
            ],
            "expo-status-bar"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
