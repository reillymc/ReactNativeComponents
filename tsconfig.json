{
    "compilerOptions": {
        "esModuleInterop": true,
        "jsx": "react-native",
        "module": "commonjs",
        "lib": [
            "DOM",
            "ESNext"
        ],
        "moduleResolution": "node",
        "noImplicitAny": true,
        "outDir": "dist",
        "sourceMap": true,
        "noEmit": true,
        "strictNullChecks": true,
        "resolveJsonModule": true,
        "target": "es2019"
    },
    "include": [
        "src",
    ],
    "exclude": [
        "node_modules",
        "example"
    ]
}