{
    "name": "React Native Components",
    "build": { "dockerfile": "Dockerfile" },
    "customizations": {
        "vscode": {
            "extensions": [
                "biomejs.biome",
                "expo.vscode-expo-tools",
                "msjsdiag.vscode-react-native"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "configureZshAsDefaultShell": true
        }
    },
    "remoteUser": "node"
}
