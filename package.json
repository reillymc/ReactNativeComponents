{
    "name": "@reillymc/react-native-components",
    "version": "0.9.4",
    "description": "A collection of React Native components and resources",
    "module": "lib/index.js",
    "react-native": "lib/index.js",
    "source": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "files": [
        "lib/**/*"
    ],
    "scripts": {
        "clean": "rm -rf ./lib",
        "build": "npm run clean && tsc -p ./tsconfig.build.json && babel --extensions .ts,.tsx ./src -d ./lib",
        "lint": "biome check --error-on-warnings",
        "prepare": "npm run build",
        "depcruise:src": "depcruise src --include-only 'src' --collapse 4 --output-type dot | dot -T svg > dependency-graph.svg",
        "start": "expo start",
        "typecheck": "tsc --noEmit -p ./tsconfig.build.json",
        "typecheck:full": "tsc --noEmit -p ./tsconfig.json"
    },
    "keywords": [
        "react-native",
        "ios",
        "android",
        "web"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reillymc/ReactNativeComponents.git"
    },
    "author": "reillymc",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/reillymc/ReactNativeComponents/issues"
    },
    "homepage": "https://github.com/reillymc/ReactNativeComponents#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "dependencies": {
        "@reillymc/es-utils": "^0.0.4",
        "lodash.merge": "^4.6.2"
    },
    "devDependencies": {
        "@babel/cli": "^7.28.3",
        "@babel/core": "^7.24.0",
        "@babel/preset-typescript": "^7.27.1",
        "@biomejs/biome": "2.2.4",
        "@expo/metro-runtime": "~55.0.6",
        "@expo/vector-icons": "^15.0.2",
        "@types/lodash.merge": "^4.6.9",
        "@types/react": "~19.2.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "babel-preset-expo": "~55.0.8",
        "dependency-cruiser": "^17.0.1",
        "expo": "^55.0.0",
        "expo-constants": "~55.0.7",
        "expo-font": "~55.0.4",
        "expo-linking": "~55.0.7",
        "expo-router": "~55.0.3",
        "expo-splash-screen": "~55.0.10",
        "expo-status-bar": "~55.0.4",
        "react-dom": "19.1.0",
        "react-native-web": "^0.21.0",
        "react-native-worklets": "0.7.2",
        "typescript": "^5.9.2"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-native": "^0.83.2",
        "react-native-gesture-handler": "^2.30.0",
        "react-native-reanimated": "^4.2.1",
        "react-native-safe-area-context": "^5.6.0",
        "react-native-screens": "^4.23.0",
        "react-native-svg": "^15.15.3"
    }
}
