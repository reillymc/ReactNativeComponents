{
    "name": "@reillymc/react-native-components",
    "version": "0.13.1",
    "description": "A collection of React Native components and resources",
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./actions": {
            "types": "./lib/types/actions/index.d.ts",
            "default": "./lib/actions/index.js"
        },
        "./display": {
            "types": "./lib/types/display/index.d.ts",
            "default": "./lib/display/index.js"
        },
        "./feedback": {
            "types": "./lib/types/feedback/index.d.ts",
            "default": "./lib/feedback/index.js"
        },
        "./forms": {
            "types": "./lib/types/forms/index.d.ts",
            "default": "./lib/forms/index.js"
        },
        "./layout": {
            "types": "./lib/types/layout/index.d.ts",
            "default": "./lib/layout/index.js"
        },
        "./overlays": {
            "types": "./lib/types/overlays/index.d.ts",
            "default": "./lib/overlays/index.js"
        },
        "./typography": {
            "types": "./lib/types/typography/index.d.ts",
            "default": "./lib/typography/index.js"
        },
        "./icons": {
            "types": "./lib/types/icons/index.d.ts",
            "default": "./lib/icons/index.js"
        },
        "./theme": {
            "types": "./lib/types/theme/index.d.ts",
            "default": "./lib/theme/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib/**/*",
        "THIRD_PARTY_NOTICES.md"
    ],
    "scripts": {
        "clean": "rm -rf ./lib",
        "build": "npm run clean && tsc -p ./tsconfig.build.json && babel --config-file ./babel.config.build.cjs --extensions .ts,.tsx ./src -d ./lib",
        "check:unused": "knip",
        "lint": "biome check --error-on-warnings",
        "lint:fix": "biome check --fix",
        "prepare": "npm run build",
        "depcruise:src": "depcruise \"src/**/*.{ts,tsx}\" --include-only 'src' --collapse 4 --output-type dot | dot -T svg > dependency-graph.svg",
        "start": "expo start",
        "typecheck": "tsc --noEmit -p ./tsconfig.build.json",
        "typecheck:full": "tsc --noEmit -p ./tsconfig.json"
    },
    "keywords": [
        "react-native",
        "ios",
        "android",
        "web"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reillymc/ReactNativeComponents.git"
    },
    "author": "reillymc",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/reillymc/ReactNativeComponents/issues"
    },
    "homepage": "https://github.com/reillymc/ReactNativeComponents#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "dependencies": {
        "@reillymc/es-utils": "^0.0.14"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.13",
        "@biomejs/biome": "2.6.6",
        "@expo/metro-runtime": "~58.0.17",
        "@react-native-vector-icons/octicons": "^22.0.0",
        "@react-native/babel-preset": "0.88.1",
        "@types/react": "~19.3.0",
        "@types/react-dom": "~19.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "babel-preset-expo": "~58.0.0",
        "dependency-cruiser": "^18.7.2",
        "expo": "^58.0.23",
        "expo-constants": "~58.0.15",
        "expo-dev-client": "~58.0.18",
        "expo-font": "~58.0.11",
        "expo-linking": "~58.0.16",
        "expo-router": "~58.0.30",
        "expo-splash-screen": "~58.0.13",
        "expo-status-bar": "~58.0.4",
        "knip": "^6.44.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.1",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.11.1",
        "react-native-screens": "~4.30.1",
        "react-native-svg": "15.16.0",
        "react-native-web": "^0.21.4",
        "react-native-worklets": "0.13.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "react": "^19.3",
        "react-native": "^0.88",
        "react-native-gesture-handler": "^3.3",
        "react-native-reanimated": "^4.7",
        "react-native-safe-area-context": "^5.11",
        "react-native-screens": "^4.30",
        "react-native-svg": "^15.16",
        "react-native-worklets": "*"
    }
}
