{
    "name": "@reillymc/react-native-components",
    "version": "0.10.4",
    "description": "A collection of React Native components and resources",
    "module": "lib/index.js",
    "react-native": "lib/index.js",
    "source": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "files": [
        "lib/**/*"
    ],
    "scripts": {
        "clean": "rm -rf ./lib",
        "build": "npm run clean && tsc -p ./tsconfig.build.json && babel --extensions .ts,.tsx ./src -d ./lib",
        "lint": "biome check --error-on-warnings",
        "lint:fix": "biome check --fix",
        "prepare": "npm run build",
        "depcruise:src": "depcruise src --include-only 'src' --collapse 4 --output-type dot | dot -T svg > dependency-graph.svg",
        "start": "expo start",
        "typecheck": "tsc --noEmit -p ./tsconfig.build.json",
        "typecheck:full": "tsc --noEmit -p ./tsconfig.json",
        "build:devclient": "eas build --platform ios --profile development"
    },
    "keywords": [
        "react-native",
        "ios",
        "android",
        "web"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reillymc/ReactNativeComponents.git"
    },
    "author": "reillymc",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/reillymc/ReactNativeComponents/issues"
    },
    "homepage": "https://github.com/reillymc/ReactNativeComponents#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "dependencies": {
        "@reillymc/es-utils": "^0.0.4",
        "lodash.merge": "^4.6.2"
    },
    "devDependencies": {
        "@babel/cli": "^7.28.3",
        "@babel/core": "^7.29.0",
        "@babel/preset-typescript": "^7.27.1",
        "@biomejs/biome": "2.4.9",
        "@expo/metro-runtime": "~56.0.15",
        "@react-native-vector-icons/octicons": "^21.1.2",
        "@types/lodash.merge": "^4.6.9",
        "@types/react": "~19.2.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "babel-preset-expo": "~56.0.0",
        "dependency-cruiser": "^17.0.1",
        "expo": "^56.0.0",
        "expo-constants": "~56.0.18",
        "expo-dev-client": "~56.0.20",
        "expo-font": "~56.0.7",
        "expo-linking": "~56.0.14",
        "expo-router": "~56.2.11",
        "expo-splash-screen": "~56.0.10",
        "expo-status-bar": "~56.0.4",
        "react-dom": "19.2.3",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.8.3",
        "typescript": "~6.0.3"
    },
    "peerDependencies": {
        "react": "^19.2",
        "react-native": "^0.85 || ^0.86",
        "react-native-gesture-handler": "^2.31",
        "react-native-reanimated": "^4.3",
        "react-native-safe-area-context": "^5.7",
        "react-native-screens": "^4.23",
        "react-native-svg": "^15.15"
    }
}
