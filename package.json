{
    "name": "@reillymc/react-native-components",
    "version": "0.6.15",
    "description": "A collection of React Native components and resources",
    "module": "lib/index.js",
    "react-native": "lib/index.js",
    "source": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "files": [
        "lib/**/*"
    ],
    "scripts": {
        "clean": "rm -rf ./lib",
        "build": "npm run clean && tsc -p ./tsconfig.build.json",
        "lint": "biome check",
        "prepare": "npm run build",
        "depcruise": "depcruise src --include-only 'src' --collapse 4 --output-type dot | dot -T svg > dependency-graph.svg",
        "start": "expo start",
        "test": "jest",
        "typecheck": "tsc --noEmit -p ./tsconfig.build.json"
    },
    "keywords": [
        "react-native",
        "ios",
        "android",
        "web"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reillymc/ReactNativeComponents.git"
    },
    "author": "reillymc",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/reillymc/ReactNativeComponents/issues"
    },
    "homepage": "https://github.com/reillymc/ReactNativeComponents#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "dependencies": {
        "@reillymc/es-utils": "^0.0.4",
        "lodash.merge": "^4.6.2"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@biomejs/biome": "2.0.6",
        "@expo/vector-icons": "^14.1.0",
        "@react-native/metro-config": "^0.76.2",
        "@react-navigation/native": "^7.0.14",
        "@types/jest": "^28.1.2",
        "@types/lodash.merge": "^4.6.9",
        "@types/react": "~19.0.10",
        "dependency-cruiser": "^16.10.4",
        "expo": "^53.0.13",
        "expo-constants": "~17.1.6",
        "expo-font": "~13.3.1",
        "expo-linking": "~7.1.5",
        "expo-router": "~5.1.1",
        "expo-splash-screen": "~0.30.9",
        "expo-status-bar": "~2.2.3",
        "jest": "^29.2.1",
        "pod-install": "^0.1.0",
        "prettier": "^2.8.3",
        "react": "19.0.0",
        "react-native": "0.79.4",
        "react-native-gesture-handler": "~2.24.0",
        "react-native-reanimated": "~3.17.4",
        "react-native-safe-area-context": "5.4.0",
        "react-native-screens": "~4.11.1",
        "react-native-web": "^0.20.0",
        "release-it": "^15.0.0",
        "typescript": "~5.8.3"
    },
    "peerDependencies": {
        "react-native-gesture-handler": "^2.24",
        "react-native-reanimated": "^3.17"
    },
    "jest": {
        "preset": "react-native",
        "modulePathIgnorePatterns": [
            "<rootDir>/example/node_modules",
            "<rootDir>/lib/"
        ]
    }
}
