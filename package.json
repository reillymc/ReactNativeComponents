{
    "name": "@reillymc/react-native-components",
    "version": "0.4.10",
    "description": "A collection of React Native components and resources",
    "module": "lib/module/index",
    "types": "lib/typescript/src/index.d.ts",
    "react-native": "src/index",
    "source": "src/index",
    "workspaces": [
        "src",
        "example"
    ],
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "cpp",
        "*.podspec",
        "!lib/typescript/example",
        "!ios/build",
        "!android/build",
        "!android/gradle",
        "!android/gradlew",
        "!android/gradlew.bat",
        "!android/local.properties",
        "!**/__tests__",
        "!**/__fixtures__",
        "!**/__mocks__",
        "!**/.*"
    ],
    "scripts": {
        "test": "jest",
        "lint": "tsc --noEmit -p ./tsconfig.build.json && biome lint",
        "build": "bob build",
        "prepare": "npm run build",
        "start": "expo start",
        "bootstrap": "yarn example && yarn install"
    },
    "keywords": [
        "react-native",
        "ios",
        "android"
    ],
    "repository": "https://github.com/reillymc/ReactNativeComponents",
    "author": "reillymc",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/reillymc/ReactNativeComponents/issues"
    },
    "homepage": "https://github.com/reillymc/ReactNativeComponents#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.8.3",
        "@expo/vector-icons": "^14.0.2",
        "@react-native-community/eslint-config": "^3.2.0",
        "@react-navigation/native": "^6.0",
        "@types/jest": "^28.1.2",
        "@types/react": "~18.2.79",
        "eslint": "^8.57.0",
        "eslint-config-expo": "^7.0.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-prettier": "^4.0.0",
        "jest": "^29.2.1",
        "pod-install": "^0.1.0",
        "prettier": "^2.8.3",
        "react": "18.2.0",
        "react-native": "0.74.3",
        "react-native-builder-bob": "^0.20.0",
        "release-it": "^15.0.0",
        "@babel/core": "^7.24.0",
        "@react-native/metro-config": "^0.75.2",
        "typescript": "^5.6",
        "expo": "^51.0.0",
        "expo-constants": "~16.0.1",
        "expo-font": "~12.0.4",
        "expo-linking": "~6.3.1",
        "expo-router": "~3.5.11",
        "expo-splash-screen": "~0.27.4",
        "expo-status-bar": "~1.12.1",
        "react-native-safe-area-context": "4.10.1",
        "react-native-screens": "3.31.1",
        "react-native-web": "~0.19.10"
    },
    "peerDependencies": {
        "@gorhom/bottom-sheet": "^5.0.0-alpha.9",
        "@gorhom/portal": "^1.0",
        "expo-blur": "^13.0.2",
        "react-native-gesture-handler": "^2.16.1",
        "react-native-reanimated": "^3.10.1"
    },
    "jest": {
        "preset": "react-native",
        "modulePathIgnorePatterns": [
            "<rootDir>/example/node_modules",
            "<rootDir>/lib/"
        ]
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            "commonjs",
            "module",
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    }
}
