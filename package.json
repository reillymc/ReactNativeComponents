{
    "name": "@reillymc/react-native-components",
    "version": "0.6.1",
    "description": "A collection of React Native components and resources",
    "module": "lib/module/index",
    "main": "expo-router/entry",
    "types": "lib/typescript/src/index.d.ts",
    "react-native": "src/index",
    "source": "src/index",
    "workspaces": [
        "src",
        "example"
    ],
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "cpp",
        "*.podspec",
        "!lib/typescript/example",
        "!ios/build",
        "!android/build",
        "!android/gradle",
        "!android/gradlew",
        "!android/gradlew.bat",
        "!android/local.properties",
        "!**/__tests__",
        "!**/__fixtures__",
        "!**/__mocks__",
        "!**/.*"
    ],
    "scripts": {
        "bootstrap": "yarn example && yarn install",
        "build": "bob build",
        "lint": "tsc --noEmit -p ./tsconfig.build.json && biome lint",
        "prepare": "npm run build",
        "start": "expo start",
        "test": "jest",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "react-native",
        "ios",
        "android"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reillymc/ReactNativeComponents.git"
    },
    "author": "reillymc",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/reillymc/ReactNativeComponents/issues"
    },
    "homepage": "https://github.com/reillymc/ReactNativeComponents#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@biomejs/biome": "2.0.6",
        "@expo/vector-icons": "^14.1.0",
        "@react-native-community/eslint-config": "^3.2.0",
        "@react-native/metro-config": "^0.76.2",
        "@react-navigation/native": "^7.0.14",
        "@types/jest": "^28.1.2",
        "@types/lodash.merge": "^4.6.9",
        "@types/react": "~19.0.10",
        "eslint": "^8.57.0",
        "eslint-config-expo": "~9.2.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-prettier": "^4.0.0",
        "expo": "^53.0.13",
        "expo-constants": "~17.1.6",
        "expo-font": "~13.3.1",
        "expo-linking": "~7.1.5",
        "expo-router": "~5.1.1",
        "expo-splash-screen": "~0.30.9",
        "expo-status-bar": "~2.2.3",
        "jest": "^29.2.1",
        "pod-install": "^0.1.0",
        "prettier": "^2.8.3",
        "react": "19.0.0",
        "react-native": "0.79.4",
        "react-native-builder-bob": "^0.20.0",
        "react-native-gesture-handler": "~2.24.0",
        "react-native-reanimated": "~3.17.4",
        "react-native-safe-area-context": "5.4.0",
        "react-native-screens": "~4.11.1",
        "react-native-web": "^0.20.0",
        "release-it": "^15.0.0",
        "typescript": "~5.8.3"
    },
    "peerDependencies": {
        "expo-blur": "^14.0",
        "react-native-gesture-handler": "^2.24",
        "react-native-reanimated": "^3.17"
    },
    "jest": {
        "preset": "react-native",
        "modulePathIgnorePatterns": [
            "<rootDir>/example/node_modules",
            "<rootDir>/lib/"
        ]
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            "commonjs",
            "module",
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    },
    "dependencies": {
        "@reillymc/es-utils": "^0.0.4",
        "lodash.merge": "^4.6.2"
    }
}
